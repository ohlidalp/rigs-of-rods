// Vehicle managed materials, transparent variants.
// See managed_mats_vehicles.material for why these carry no shader or vertex colour setup.

material managed/mesh_transparent/simple
{
	technique BaseTechnique
	{
		pass BaseRender
		{
			scene_blend alpha_blend
			alpha_rejection greater 0
			depth_write off

			texture_unit Diffuse_Map
			{
				texture FilledAtSpawn
			}
		}
	}
}


material managed/mesh_transparent/specular
{
	technique BaseTechnique
	{
		pass BaseRender
		{
			scene_blend alpha_blend
			alpha_rejection greater 0
			depth_write off
			specular 1 1 1 1 127

			texture_unit Diffuse_Map
			{
				texture FilledAtSpawn
			}
			texture_unit Specular_Map
			{
				texture FilledAtSpawn
			}
		}
	}
}


