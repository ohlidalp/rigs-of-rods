// Vehicle managed materials, opaque variants.
//
// These are plain fixed-function declarations on purpose: RTSS generates the actual
// shaders, and `RTSSManager::ApplyActorShading()` attaches the vehicle surface shading
// once ActorSpawner has filled in the textures. Do not add vertex colour tracking here -
// the vertex colour carries per-node damage and wetness flags, not a colour, and the
// shading sub render state reads it directly.

material managed/mesh_standard/simple
{
	technique BaseTechnique
	{
		pass BaseRender
		{
			texture_unit Diffuse_Map
			{
				texture FilledAtSpawn
			}
		}
	}
}


material managed/mesh_standard/specular
{
	technique BaseTechnique
	{
		pass BaseRender
		{
			specular 1 1 1 1 127

			texture_unit Diffuse_Map
			{
				texture FilledAtSpawn
			}
			texture_unit Specular_Map
			{
				texture FilledAtSpawn
			}
		}
	}
}


