// PixelMetal - hand-written replacement for the legacy 'nicemetal_mm.cg'.
//
// The shader sources are cross-platform (OgreUnifiedShader.h), but a program declaration
// still names one language, so each is declared per language and wrapped in a 'unified'
// program. OGRE then picks the first delegate the current render system supports, which is
// why the material scripts reference only the unified names.

vertex_program NiceMetal_VS_mm_GLSL glsl
{
    //ORIG: source nicemetal_mm.cg,    entry_point main_nicemetal_vp,    profiles vs_1_1 arbvp1
    
    source mm_pixelmetal_vert.glsl
    default_params
    {
        param_named_auto worldviewproj worldviewproj_matrix
        param_named_auto lightPosition light_position_object_space 0
        param_named_auto eyePosition camera_position_object_space
    }
}

vertex_program NiceMetal_VS_mm_HLSL4 hlsl
{
    entry_point main
    target vs_4_0
    //ORIG: source nicemetal_mm.cg,    entry_point main_nicemetal_vp,    profiles vs_1_1 arbvp1
    
    source mm_pixelmetal_vert.glsl
    default_params
    {
        param_named_auto worldviewproj worldviewproj_matrix
        param_named_auto lightPosition light_position_object_space 0
        param_named_auto eyePosition camera_position_object_space
    }
}

vertex_program NiceMetal_VS_mm_HLSL3 hlsl
{
    entry_point main
    target vs_3_0
    //ORIG: source nicemetal_mm.cg,    entry_point main_nicemetal_vp,    profiles vs_1_1 arbvp1
    
    source mm_pixelmetal_vert.glsl
    default_params
    {
        param_named_auto worldviewproj worldviewproj_matrix
        param_named_auto lightPosition light_position_object_space 0
        param_named_auto eyePosition camera_position_object_space
    }
}

vertex_program NiceMetal_VS_mm unified
{
    delegate NiceMetal_VS_mm_HLSL4
    delegate NiceMetal_VS_mm_HLSL3
    delegate NiceMetal_VS_mm_GLSL
}

fragment_program NiceMetal_PS_mm_GLSL glsl
{
    //ORIG: source nicemetal_mm.cg,    entry_point main_nicemetal_fp,    profiles ps_2_0 arbfp1
    
    source mm_pixelmetal_frag.glsl
    default_params
    {
        param_named_auto lightDiffuse light_diffuse_colour 0
        param_named_auto lightSpecular light_specular_colour 0
        param_named exponent float 127
        param_named_auto ambient ambient_light_colour
    }
}

